---
// Titular de sección: antetítulo en letra menuda (caja normal) + título en Libre Caslon Display + entrada.
// Sin campos, no pinta nada. `cabeza`: título a la izquierda y entrada a la derecha en escritorio (líneas de base alineadas).
interface Props { titulo?: string; antetitulo?: string; texto?: string; class?: string; nivel?: 1 | 2; cabeza?: boolean }
const { titulo, antetitulo, texto, class: clase = '', nivel = 2, cabeza = false } = Astro.props;
const H = nivel === 1 ? 'h1' : 'h2';
---

{
  (titulo || antetitulo || texto) && (
    cabeza ? (
      <div class:list={['cabeza', clase]}>
        <div>
          {antetitulo && <p class="antetitulo">{antetitulo}</p>}
          {titulo && <H class="titulo-seccion">{titulo}</H>}
        </div>
        {texto && <p class="entrada">{texto}</p>}
      </div>
    ) : (
      <div class:list={['titular', clase]}>
        {antetitulo && <p class="antetitulo">{antetitulo}</p>}
        {titulo && <H class="titulo-seccion">{titulo}</H>}
        {texto && <p class="entrada">{texto}</p>}
      </div>
    )
  )
}
