---
// Apartado de texto genérico (apartados nuevos del cliente: site.yaml → `tipo: texto`): antetítulo, título,
// párrafos (separados por una línea en blanco), `items` en filas con filete y `cta`. Con `imagen`, mitad texto y
// mitad foto a sangre a la derecha; sin ella, una banda de papel con el titular a la izquierda y el texto a la derecha.
import { seccion, parrafos, externo } from '../../data/site';
import { altSeccion } from '../../lib/seo';
import Imagen from '../ui/Imagen.astro';
interface Props { id: string; primera?: boolean }
const s = seccion(Astro.props.id);
const items = s ? s.items.filter((it) => it && it.titulo) : [];
const H = Astro.props.primera ? 'h1' : 'h2';
---

{
  s && (
    <section id={Astro.props.id} class:list={[s.imagen ? 'mitades' : 'banda']}>
      <div class:list={[s.imagen ? 'mitad-texto' : 'contenedor texto-rejilla']}>
        <div class="titular">
          {s.antetitulo && <p class="antetitulo">{s.antetitulo}</p>}
          {s.titulo && <H class="titulo-seccion">{s.titulo}</H>}
        </div>
        <div>
          {parrafos(s.texto).length > 0 && (
            <div class:list={['parrafos', { 'mt-0': !s.imagen }]}>{parrafos(s.texto).map((p) => <p>{p}</p>)}</div>
          )}
          {items.length > 0 && (
            <ul class="lista-filas">
              {items.map((it) => (
                <li>
                  <p class="filas-titulo">{it.titulo}</p>
                  {it.texto && <p class="filas-texto mt-1">{it.texto}</p>}
                </li>
              ))}
            </ul>
          )}
          {s.cta?.url && (
            <p class="botones"><a class="btn" href={s.cta.url} {...(externo(s.cta.url) && { rel: 'noopener', target: '_blank' })}>{s.cta.texto}</a></p>
          )}
        </div>
      </div>
      {s.imagen && (
        <div class="mitad-foto foto">
          <Imagen src={s.imagen} alt={altSeccion(s)} ancho={1200} alto={900} />
        </div>
      )}
    </section>
  )
}

<style>
  .texto-rejilla { display: grid; gap: 1.5rem; }
  @media (min-width: 60rem) { .texto-rejilla { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 4rem; align-items: start; } }
</style>
