---
// Pie «taller»: banda de nogal (color primario) a todo el ancho con el nombre muy grande en Libre Caslon Display
// (mástil) y cuatro columnas: el taller (dirección), horario, contacto y menú con redes. Todo de site.yaml →
// contacto, redes y menu. «Web creada con NoExpertise» se muestra si site.yaml → marca_pie no es false (plan gratis).
// En móvil, barra fija abajo con «Llamar» y «WhatsApp» (o, sin WhatsApp, «Presupuesto» hacia su sección o el contacto).
import { site, tel, mapa, whatsapp, seccion, localidadesZonas } from '../data/site';
import { enlace } from '../lib/multipagina';
import Icono from './ui/Icono.astro';
interface Props { variante?: string }
const { variante = 'taller' } = Astro.props;
const c = site.contacto;
const redes = Object.entries(site.redes).filter(([, url]) => url);
const anio = new Date().getFullYear();
const zonas = localidadesZonas(8);
const pedir = c.whatsapp
  ? { texto: 'WhatsApp', url: whatsapp(c.whatsapp, `Hola, quiero pedir presupuesto a ${site.nombre}`), fuera: true }
  : seccion('presupuesto')
    ? { texto: 'Presupuesto', url: enlace('/#presupuesto'), fuera: false }
    : seccion('contacto')
      ? { texto: 'Escribir', url: enlace('/#contacto'), fuera: false }
      : null;
---

<footer class={`pie pie--${variante}`}>
  <div class="contenedor">
    <p class="pie-gigante">{site.nombre}</p>
    {site.eslogan && <p class="pie-eslogan">{site.eslogan}</p>}
    <div class="pie-columnas">
      {
        (c.direccion || zonas.length > 0) && (
          <div>
            <p class="pie-titulo">El taller</p>
            {c.direccion && (
              <p class="pie-dato">
                <a href={mapa(c.direccion)} rel="noopener" target="_blank">{c.direccion}</a>
              </p>
            )}
            {zonas.length > 0 && <p class="pie-dato mt-3">Montamos en {zonas.join(', ')}.</p>}
          </div>
        )
      }
      {
        c.horario && (
          <div>
            <p class="pie-titulo">Horario</p>
            <p class="pie-dato">{c.horario}</p>
          </div>
        )
      }
      {
        (c.telefono || c.email || c.whatsapp) && (
          <div>
            <p class="pie-titulo">Contacto</p>
            <ul class="pie-lista pie-dato">
              {c.telefono && <li><a href={tel(c.telefono)}>{c.telefono}</a></li>}
              {c.whatsapp && <li><a href={whatsapp(c.whatsapp)} rel="noopener" target="_blank">WhatsApp</a></li>}
              {c.email && <li class="break-words"><a href={`mailto:${c.email}`}>{c.email}</a></li>}
            </ul>
          </div>
        )
      }
      {
        (site.menu.length > 0 || redes.length > 0) && (
          <div>
            {site.menu.length > 0 && (
              <>
                <p class="pie-titulo">En esta web</p>
                <ul class="pie-lista">
                  {site.menu.map((e) => <li><a href={e.url}>{e.texto}</a></li>)}
                </ul>
              </>
            )}
            {redes.length > 0 && (
              <ul class="pie-redes">
                {redes.map(([red, url]) => (
                  <li>
                    <a href={url} rel="noopener" target="_blank" aria-label={red}>
                      <Icono nombre={red} tam={20} />
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        )
      }
    </div>
  </div>
  <div class="contenedor pie-legal">
    <span>© {anio} {site.nombre}</span>
    <a href="/aviso-legal">Aviso legal y privacidad</a>
    {
      site.marca_pie && (
        <span class="pie-noexpertise">
          Web creada con <a href="https://noexpertise.com" rel="noopener">NoExpertise</a>
        </span>
      )
    }
  </div>
  {
    (c.telefono || pedir) && (
      <nav class="barra-movil" aria-label="Llamar o pedir presupuesto">
        {c.telefono && (
          <a class="btn-borde" href={tel(c.telefono)}>
            <Icono nombre="telefono" tam={18} /> Llamar
          </a>
        )}
        {pedir && (
          <a class="btn" href={pedir.url} {...(pedir.fuera && { rel: 'noopener', target: '_blank' })}>
            {pedir.texto}
          </a>
        )}
      </nav>
    )
  }
</footer>
